# Gen X Gallery — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; never commit real values. For deployments, set the same names in
# the Vercel project settings (Settings → Environment Variables).
#
# ── Which of these reach the browser ──────────────────────────────────────
# Vite inlines any VITE_-prefixed variable into the client bundle at build
# time. Anything VITE_-prefixed is PUBLIC. Everything without the prefix is
# read only by the serverless functions in api/ and never shipped to the client.
#
# Never add a VITE_ prefix to a secret. In particular there must never be a
# VITE_RESEND_API_KEY, VITE_ADMIN_PASSWORD or VITE_SUPABASE_SERVICE_ROLE_KEY.


# ── Public (browser) ──────────────────────────────────────────────────────

# Supabase project URL and anon key.
# Dashboard → Project Settings → API.
# The anon key is safe to expose ONLY because Row Level Security is enabled on
# profiles / addresses / orders. Run supabase/schema.sql and, on an existing
# database, supabase/rls-fixes.sql before going live.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Analytics measurement IDs. Optional — analytics is skipped when unset.
# These are public identifiers by design, not secrets.
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=


# ── Server-only (serverless functions) ────────────────────────────────────

# Resend API key, used by api/send-order-confirmation.js to send order
# confirmation emails. https://resend.com/api-keys
# Server-side only. Emails are silently skipped if this is unset.
RESEND_API_KEY=your-resend-api-key

# Admin panel password, verified by api/admin-auth.js.
# Never referenced from client code — the browser only ever sees a signed,
# httpOnly session cookie. Use something long and random.
ADMIN_PASSWORD=choose-a-long-random-password

# Secret used to HMAC-sign the admin session cookie. Changing it invalidates
# all existing admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=generate-a-32-byte-random-hex-string


# ── Notes ─────────────────────────────────────────────────────────────────
#
# VERCEL_OIDC_TOKEN may appear in your local .env.local — the Vercel CLI writes
# it automatically. You do not need to set it yourself.
#
# `npm run dev` runs Vite only and does NOT serve api/*, so admin login will
# report "Admin login is unavailable right now." Use `vercel dev` when you need
# the serverless functions locally.
